{
  "version": "0.2.0",
  "project": "字海残卷",
  "design_goal": {
    "core_loop": "战斗获取基础字根，先形成结构字，再通过升级、卷页、遗物、题名等方式进入进阶字与词技，最终用这一整套语言结构解决越来越复杂的战场问题。",
    "primary_pleasure": "不是单纯升级变强，而是“我的字成了、我的字长成词了”",
    "design_principles": [
      "不要把汉字退化成皮肤",
      "结构合成必须讲得通",
      "语义进阶不伪装成构形合成",
      "词技是毕业层，不要求双完整字树",
      "成语与题名是低频高价值的章级改写器",
      "遗物与商店优先卖构词机会，而不是纯数值"
    ]
  },
  "system_layers": {
    "layer_a_runes": {
      "name": "基础字根层",
      "role": "局内高频获取的种子资源",
      "rules": [
        "常驻主池",
        "用于形成结构字",
        "也可作为词技副义来源"
      ]
    },
    "layer_b_structural_chars": {
      "name": "结构字层",
      "role": "由基础字根合理构成的核心 build 单位",
      "rules": [
        "只有构形合理的字进入本层",
        "是玩家一局主养的核心字",
        "升到3级后可作为进阶字或词技前置"
      ]
    },
    "layer_c_advanced_chars": {
      "name": "进阶字层",
      "role": "由结构字通过升级、卷页、遗物、题名等方式转义晋阶",
      "rules": [
        "不要求构形合成",
        "表达字意强化、风格专精、玩法转向",
        "是结构字到词技之间的重要中层"
      ]
    },
    "layer_d_word_skills": {
      "name": "词技层",
      "role": "中后期毕业层",
      "rules": [
        "采用“主字3级 + 副义来源”模式",
        "不要求两棵完整字树",
        "要带来明显玩法变化，不只是数值提高"
      ]
    },
    "layer_e_titles_and_idioms": {
      "name": "题名/成语层",
      "role": "章级改写器",
      "rules": [
        "不进入普通升级池",
        "只由Boss、守门怪、异事、章末奖励提供",
        "低频但极强，承担段落终点感"
      ]
    }
  },
